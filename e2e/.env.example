# Skills App E2E Test Configuration
SKILLS_HOST=http://localhost:3000
AUTH_HOST=https://auth.iblai.org

# Authentication — admin account (drives every journey except 41)
PLAYWRIGHT_USERNAME=your-test-user@example.com
PLAYWRIGHT_PASSWORD=your-test-password
AUTH_FLOW=username_password
AUTH_IDP=

# Authentication — non-admin (student) account. Drives Journey 41, which runs in
# the `skills-desktop-chrome-student` project and asserts what a learner cannot
# see. Leave blank to skip that setup and project.
PLAYWRIGHT_NONADMIN_USERNAME=
PLAYWRIGHT_NONADMIN_PASSWORD=

# Optional
EMBED_URL=https://conradmugabe.vercel.app/
INVITE_USERNAME=
INVITE_USER_PASSWORD=

# Platform selection for auth setup
PLATFORM=skills
